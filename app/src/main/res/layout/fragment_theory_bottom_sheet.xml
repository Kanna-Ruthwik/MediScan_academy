<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#555555" />

    <!-- Sheet Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gonzalez &amp; Woods (4th Ed.)"
                android:textColor="@color/teal_medical"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Digital Image Processing Mathematical Models &amp; Clinical Scenarios"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_theory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Theory Dialog"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:background="@color/divider_color" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CHAPTER 1: INTRODUCTION -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 1: INTRODUCTION &amp; EM SPECTRUM MODALITIES"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• 1.3.1 Gamma-Ray: Positron emission tomography (PET), radioisotope bone scans\n• 1.3.2 X-Ray: Chest radiography, fluoroscopy, CT computed tomography\n• 1.3.3 Ultraviolet: Fluorescence microscopy, DNA nucleotide binding\n• 1.3.4 Visible &amp; IR: Light microscopy histopathology, medical thermography\n• 1.3.5 Microwave: Radar cross-section backscatter, SAR planetary imaging\n• 1.3.6 Radio: Magnetic resonance imaging (MRI) 2D Fourier RF echoes\n• 1.3.7 Other: Acoustic ultrasound (Rayleigh speckle), Electron microscopy (TEM/SEM)"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Pedagogical Context:\nSection 1.4 defines the fundamental steps: Acquisition → Enhancement → Restoration → Wavelets/Multiresolution → Compression → Morphological Processing → Segmentation → Feature Representation → Recognition. MediScan embeds these authentic DSP pipelines directly into an educational interactive workstation."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CHAPTER 2: DIGITAL IMAGE FUNDAMENTALS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 2: DIGITAL IMAGE FUNDAMENTALS"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• Visual Perception (2.1): Mach Bands lateral inhibition &amp; Simultaneous Contrast\n• Continuous Model (2.3): f(x,y) = i(x,y) · r(x,y) [Illumination 0&lt;i&lt;∞, Reflectance 0&lt;r&lt;1]\n• Sampling &amp; Quantization (2.4): N×M spatial grid, L = 2^k intensity levels (1..8 bits)\n• False Contouring (2.4.2): Ridges formed when intensity levels k &lt; 8\n• Bit-Plane Slicing (2.6.2): Bit 7 holds ~50% visual energy; bit 0 carries noise\n• Distance Metrics (2.5.2): De=√((x-s)²+(y-t)²), D4=|x-s|+|y-t|, D8=max(|x-s|,|y-t|)\n• Digital Subtraction Angiography (2.6.3): g(x,y) = c · (f(x,y) - h_mask(x,y))"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Significance:\nUnderstanding human visual brightness discrimination and sampling bounds prevents diagnostic error from aliasing artifacts, checkerboard pixellation, or false contouring in low-dose radiologic digitization."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 1 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 3: INTENSITY TRANSFORMATIONS &amp; HISTOGRAMS"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• Log Transform:  s = c · log(1 + r)\n• Gamma Transform:  s = c · r^γ\n• Histogram Equalization:  s_k = (L - 1) · Σ_{j=0}^k (n_j / MN)"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: Compresses broad dynamic range in raw radiological detectors; enhances micro-calcifications in mammography and subtle lung nodules in under-exposed chest radiographs."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 2 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 3: SPATIAL FILTERING &amp; CONVOLUTION ENGINE"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• 2D Spatial Convolution:\n  g(x,y) = Σ_{s=-a}^a Σ_{t=-b}^b w(s,t) · f(x+s, y+t)\n• Sobel Magnitude:  M(x,y) = √(G_x² + G_y²)\n• Median Filter:  g(x,y) = median { f(s,t) ∈ S_xy }\n• Laplacian Sharpening:  ∇²f = ∂²f/∂x² + ∂²f/∂y²"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: Median filters eradicate speckle/acoustic clutter in ultrasound while strictly preserving cardiac and hepatic wall boundaries; Sobel operators isolate cortical bone margins and microfractures in high-resolution CT."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 3 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 4: FREQUENCY DOMAIN &amp; 2D FFT"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• 2D DFT:  F(u,v) = Σ_x Σ_y f(x,y) · e^(-j 2π (ux/M + vy/N))\n• FFT Shift Centering:  f(x,y) · (-1)^(x+y) ⇔ F(u - M/2, v - N/2)\n• Gaussian Lowpass (GLPF):  H(u,v) = exp(-D²(u,v) / (2·D₀²))\n• Ideal Lowpass (ILPF):  H(u,v) = 1 if D(u,v) ≤ D₀ else 0"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: k-Space manipulation in Magnetic Resonance Imaging (MRI); suppresses periodic interference stripes caused by patient respiratory motion or electronic hardware line noise."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 4 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 10: AUTOMATED IMAGE SEGMENTATION"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• Otsu's Criterion (Maximize Between-Class Variance):\n  σ_B²(k) = [μ_T · P₁(k) - m(k)]² / (P₁(k) · [1 - P₁(k)])\n• Optimal Threshold:  k* = argmax_{k} { σ_B²(k) }\n• Global Thresholding:  g(x,y) = 255 if f(x,y) > T else 0"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: Automated zero-touch segmentation of lung parenchyma in pneumothorax assessment, acute ischemic stroke infarcts on CT, and cortical bone mass isolation."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- MODULE 5 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 9: MORPHOLOGICAL IMAGE PROCESSING"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• Erosion:  A ⊖ B = { z | (B)_z ⊆ A }\n• Dilation:  A ⊕ B = { z | (B̂)_z ∩ A ≠ ∅ }\n• Opening:  A ∘ B = (A ⊖ B) ⊕ B\n• Closing:  A • B = (A ⊕ B) ⊖ B\n• Boundary Extraction:  β(A) = A - (A ⊖ B)"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: Eliminates spurious parasitic noise bridges between adjacent blood vessels in angiography; extracts sharp myocardial contour loops for ventricular volume calculation."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CHAPTER 5: IMAGE RESTORATION AND NOISE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 5: IMAGE RESTORATION &amp; RECONSTRUCTION"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• Degradation Model: g(x,y) = h(x,y) ★ f(x,y) + η(x,y)\n• Impulse (Salt &amp; Pepper): P(z=a)=Pa, P(z=b)=Pb\n• Gaussian Noise: p(z) = 1/(√(2π)σ) · e^(-(z-z̄)²/(2σ²))\n• Geometric Mean: f̂(x,y) = [ ∏ g(s,t) ]^(1/mn) [smooths without losing sharpness]\n• Harmonic Mean: f̂(x,y) = mn / ∑ [1 / g(s,t)] [good for salt noise]\n• Contraharmonic: f̂(x,y) = ∑ g^(Q+1) / ∑ g^Q [Q&gt;0: pepper, Q&lt;0: salt]\n• Alpha-Trimmed Mean: Drops d/2 lowest and d/2 highest values\n• Adaptive Wiener Filter: f̂ = μ + ((σ² - σ_η²)/σ²) · (g - μ)"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: Removes detector thermal agitation in low-dose CT, reduces acoustic speckle in B-mode ultrasound, and suppresses salt-and-pepper artifacts in faulty telemetry transmissions."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CHAPTER 6: COLOR IMAGE PROCESSING -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:cardCornerRadius="10dp"
                app:strokeColor="#333333"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHAPTER 6: COLOR IMAGE PROCESSING &amp; PSEUDOCOLOR"
                        android:textColor="@color/teal_medical"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="#121212"
                        android:padding="8dp"
                        android:text="• HSI Model (6.2.3): Hue (dominant wavelength), Saturation (purity), Intensity (achromatic brightness)\n• Decoupling: I = (R+G+B)/3; allows contrast enhancement without chromatic distortion\n• Intensity Slicing (6.3.1): Maps gray intervals to diagnostic color planes (isophotes)\n• Gray-Level to Color (6.3.2): Continuous transfer functions fR(r), fG(r), fB(r)\n  - Medical Thermal: Black → Red → Orange → White (vascular/inflammation mapping)\n  - PET Hot Metal: Low uptake (violet) to hypermetabolic neoplasm (hot white/yellow)"
                        android:textColor="#E0E0E0"
                        android:textSize="11sp"
                        android:typeface="monospace" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Clinical Application: The human eye can discern thousands of color shades vs. only dozens of gray levels. Pseudocolor maps dramatically enhance lesion detection in nuclear scintigraphy, functional MRI, and thermography."
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
