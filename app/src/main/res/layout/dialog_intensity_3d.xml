<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D Intensity Topography"
                    android:textColor="@color/teal_medical"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_selected"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:text="v2.0 3D"
                    android:textColor="@color/bg_dark"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gonzalez &amp; Woods Sec. 2.4 — Elevation Surface f(x, y) = z"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_3d"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close 3D View"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Main 3D Interactive Viewport -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0F14">

        <com.example.mediscan.ui.Intensity3DView
            android:id="@+id/intensity_3d_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating Stats Chip on top-right -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_3d_slice_stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slice Plane: T = 128"
                android:textColor="@color/amber_caution"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_3d_area_stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Above Plane: 50.0%"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_3d_range_stat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Range: [0 .. 255]"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Control Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Slicing Plane Slider Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Slicing Plane (T):"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekbar_slice_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="255"
                android:progress="128"
                android:progressTint="@color/amber_caution"
                android:thumbTint="@color/amber_caution" />

            <TextView
                android:id="@+id/tv_slice_value"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="128"
                android:textColor="@color/amber_caution"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Preset Slicing Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Presets:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_preset_64"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="T=64 (Shadows)"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_preset_128"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="T=128 (Mid)"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btn_preset_192"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="T=192 (Peaks)"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Slicing Color Palette & 3D Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Palette Toggle Group -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_palette"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btn_palette_jet"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Jet"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_palette_thermal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Thermal"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btn_palette_mono"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="Mono"
                    android:textSize="10sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Auto Rotate Button -->
            <Button
                android:id="@+id/btn_auto_rotate"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Auto Spin"
                android:textSize="10sp" />

            <!-- Reset Angle Button -->
            <Button
                android:id="@+id/btn_reset_view"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Reset Angle"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
